rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function userPath(userId) {
      return /databases/$(database)/documents/users/$(userId);
    }

    function hasReservittaProfile() {
      return isSignedIn()
          && exists(userPath(request.auth.uid));
    }

    function isReservittaAdmin() {
      return hasReservittaProfile()
          && get(userPath(request.auth.uid)).data.rol == 'admin';
    }

    function isAdminAfterRegistration() {
      return isSignedIn()
          && existsAfter(userPath(request.auth.uid))
          && getAfter(userPath(request.auth.uid)).data.rol == 'admin';
    }

    // Las credenciales de Firebase Auth no bastan: el perfil debe pertenecer al UID.
    match /users/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow create: if isSignedIn()
                    && request.auth.uid == userId
                    && request.resource.data.uid == userId
                    && request.resource.data.rol in ['admin', 'visitante'];
      allow update: if isSignedIn()
                    && request.auth.uid == userId
                    && request.resource.data.uid == userId
                    && request.resource.data.rol == resource.data.rol;
      allow delete: if false;
    }

    match /serviciosCatalogo/{servicioId} {
      // HU01-RF01: Catálogo de servicios público accesible sin autenticación
      allow read: if true;
      allow write: if isReservittaAdmin();
    }

    match /restaurants/{restaurantId} {
      // HU01-RF01 Criterios 3 y 4: Las reglas de Firestore permiten leer los campos públicos sin autenticación.
      // HU01-RF03: Navegación pública sin sesión.
      allow read: if true;
      allow create: if isAdminAfterRegistration()
                    && request.resource.data.adminId == userPath(request.auth.uid);
      allow update: if isReservittaAdmin()
                    && resource.data.adminId == userPath(request.auth.uid);
      allow delete: if false;

      match /sucursales/{sucursalId} {
        // HU01-RF01: Sucursales de restaurantes accesibles públicamente
        allow read: if true;
        allow create, update, delete: if isReservittaAdmin();
      }

      match /categorias/{categoriaId} {
        allow read: if true;
        allow create, update, delete: if isReservittaAdmin();
      }

      match /platillos/{platilloId} {
        allow read: if true;
        allow create, update, delete: if isReservittaAdmin();
      }

      match /zonas/{zonaId} {
        allow read: if true;
        allow create, update, delete: if isReservittaAdmin();
      }

      match /mesas/{mesaId} {
        allow read: if true;
        allow create, update, delete: if isReservittaAdmin();
      }

      match /ocasiones/{ocasionId} {
        allow read: if true;
        allow create, update, delete: if isReservittaAdmin();

        match /experiencias/{experienciaId} {
          allow read: if true;
          allow create, update, delete: if isReservittaAdmin();
        }
      }
    }

    match /reservations/{reservationId} {
      // Las reservaciones sí requieren cuenta y estar autenticado (HU01-RF03)
      allow read, create, update: if hasReservittaProfile();
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
