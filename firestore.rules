rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function userPath(userId) {
      return /databases/$(database)/documents/users/$(userId);
    }

    function hasReservittaProfile() {
      return isSignedIn()
          && exists(userPath(request.auth.uid));
    }

    function isReservittaAdmin() {
      return hasReservittaProfile()
          && get(userPath(request.auth.uid)).data.rol == 'admin';
    }

    function isVisitorProfile() {
      return hasReservittaProfile()
          && get(userPath(request.auth.uid)).data.rol == 'visitante';
    }

    // HU26-RF01 Criterio 4: Garantiza que un administrador solo vea y gestione
    // las reservas que pertenecen a su propio restaurante autenticado.
    function isAdminOfReservationRestaurant(reservationData) {
      let userData = get(userPath(request.auth.uid)).data;
      let restId = reservationData.restauranteId;
      return hasReservittaProfile()
          && userData.rol == 'admin'
          && (
            userData.restauranteId == restId
            || (restId is string
                && userData.restauranteId == /databases/$(database)/documents/restaurants/$(restId))
          );
    }

    // Sprint 8: el administrador solo gestiona los datos operativos de su propio restaurante.
    function isAdminOfRestaurantId(restId) {
      let userData = get(userPath(request.auth.uid)).data;
      return hasReservittaProfile()
          && userData.rol == 'admin'
          && (
            userData.restauranteId == restId
            || userData.restauranteId == /databases/$(database)/documents/restaurants/$(restId)
          );
    }

    function isAdminAfterRegistration() {
      return isSignedIn()
          && existsAfter(userPath(request.auth.uid))
          && getAfter(userPath(request.auth.uid)).data.rol == 'admin';
    }

    // Las credenciales de Firebase Auth no bastan: el perfil debe pertenecer al UID.
    match /users/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow create: if isSignedIn()
                    && request.auth.uid == userId
                    && request.resource.data.uid == userId
                    && request.resource.data.rol in ['admin', 'visitante'];
      allow update: if isSignedIn()
                    && request.auth.uid == userId
                    && request.resource.data.uid == userId
                    && request.resource.data.rol == resource.data.rol;
      allow delete: if false;
    }

    match /serviciosCatalogo/{servicioId} {
      // HU01-RF01: Catálogo de servicios público accesible sin autenticación
      allow read: if true;
      allow write: if isReservittaAdmin();
    }

    match /restaurants/{restaurantId} {
      // HU01-RF01 Criterios 3 y 4: Las reglas de Firestore permiten leer los campos públicos sin autenticación.
      // HU01-RF03: Navegación pública sin sesión.
      allow read: if true;
      allow create: if isAdminAfterRegistration()
                    && request.resource.data.adminId == userPath(request.auth.uid);
      allow update: if isReservittaAdmin()
                    && resource.data.adminId == userPath(request.auth.uid);
      allow delete: if false;

      match /sucursales/{sucursalId} {
        // HU01-RF01: Sucursales de restaurantes accesibles públicamente
        allow read: if true;
        allow create, update, delete: if isReservittaAdmin();
      }

      match /categorias/{categoriaId} {
        allow read: if true;
        allow create, update, delete: if isReservittaAdmin();
      }

      match /platillos/{platilloId} {
        allow read: if true;
        allow create, update, delete: if isReservittaAdmin();
      }

      match /zonas/{zonaId} {
        allow read: if true;
        allow create, update, delete: if isReservittaAdmin();
      }

      match /mesas/{mesaId} {
        allow read: if true;
        allow create, update, delete: if isReservittaAdmin();
      }

      // Elementos decorativos del plano (barra, paredes, puertas…): los ve cualquiera.
      match /elementos/{elementoId} {
        allow read: if true;
        allow create, update, delete: if isReservittaAdmin();
      }

      // Historial de cambios del plano: solo lo ve y lo escribe el administrador.
      match /planHistorial/{cambioId} {
        allow read, create: if isReservittaAdmin();
        allow update, delete: if false;
      }

      // HU11-RF04: la reserva transaccional lee y actualiza la ocupación de cada
      // mesa por día para evitar reservas dobles. Requiere un perfil de Reservitta.
      match /ocupacionMesas/{ocupacionId} {
        // Es información de disponibilidad (horas ocupadas), no datos personales.
        // Quien gestiona con token también la actualiza sin iniciar sesión (HU20).
        allow read: if true;
        allow create, update: if hasReservittaProfile()
                              || request.resource.data.keys()
                                   .hasOnly(['mesaId', 'fechaLocal', 'intervalos']);
        allow delete: if false;
      }

      // HU30-RF02: alertas de llegada registradas para el administrador (una por
      // reserva, tipo y umbral). Solo las ve y las escribe el administrador del restaurante.
      match /alertasAdmin/{alertaId} {
        allow read, create, update: if isAdminOfRestaurantId(restaurantId);
        allow delete: if false;
      }

      // HU30-RF02: cola de mensajes push (FCM) que un proceso de servidor entrega
      // a los dispositivos del administrador.
      match /colaPush/{mensajeId} {
        allow read, create, update: if isAdminOfRestaurantId(restaurantId);
        allow delete: if false;
      }

      // HU21-RF01: recordatorio de cada reserva. Se programa al confirmar la reserva
      // (cualquier perfil de Reservitta) y el administrador lo concilia y lo envía.
      match /recordatorios/{reservaId} {
        allow create: if hasReservittaProfile();
        allow read, update: if isAdminOfRestaurantId(restaurantId);
        allow delete: if false;
      }

      match /ocasiones/{ocasionId} {
        allow read: if true;
        allow create, update, delete: if isReservittaAdmin();

        match /experiencias/{experienciaId} {
          allow read: if true;
          allow create, update, delete: if isReservittaAdmin();
        }
      }
    }

    // HU20-RF01/RF02: gestión de la reserva con un token, sin iniciar sesión.
    // Una operación con token solo es válida si, en la misma escritura, también se
    // actualiza el documento público gestionReservas/{token} con la hora del servidor:
    // para escribir ese documento hay que conocer el token (no se puede listar).
    function tokenOperation(token) {
      return token is string
          && exists(/databases/$(database)/documents/gestionReservas/$(token))
          && getAfter(/databases/$(database)/documents/gestionReservas/$(token))
               .data.ultimaOperacionEn == request.time;
    }

    match /gestionReservas/{token} {
      // El token es secreto y largo: leerlo por id es suficiente; no se puede listar.
      allow get: if true;
      allow list: if false;
      allow create: if hasReservittaProfile()
                    && request.resource.data.usuarioId == request.auth.uid;
      allow update: if resource.data.expiraEn > request.time
                    && request.resource.data.ultimaOperacionEn == request.time
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['estado', 'fechaLocal', 'inicio', 'fin', 'duracionMin',
                                   'personas', 'mesaIds', 'mesasNombres', 'expiraEn',
                                   'ultimaOperacionEn']);
      allow delete: if false;
    }

    match /reservations/{reservationId} {
      // Las reservaciones sí requieren cuenta y estar autenticado (HU01-RF03).
      // HU26-RF01 Criterio 4: Las reglas de Firestore garantizan que un
      // administrador solo vea las reservas de su propio restaurante.
      allow read: if isAdminOfReservationRestaurant(resource.data)
                  || isVisitorProfile();
      allow create: if hasReservittaProfile();
      allow update: if isAdminOfReservationRestaurant(resource.data)
                    || isVisitorProfile()
                    || (tokenOperation(resource.data.tokenGestion)
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['estado', 'estadoActualizadoPor', 'estadoActualizadoEn',
                                       'historialEstados', 'fechaLocal', 'inicio', 'fin',
                                       'duracionMin', 'personas', 'cantidadPersonas',
                                       'mesaIds', 'mesasNombres', 'ultimaModificacionEn']));
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
