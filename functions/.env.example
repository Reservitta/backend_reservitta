# Copia este archivo como `.env` (no se sube al repositorio) antes de desplegar.
# Clave de Resend para enviar los recordatorios por correo. Si se deja vacía, los
# correos se escriben en la colección `mail` (extensión "Trigger Email").
RESEND_API_KEY=
RESEND_SENDER=Reservitta <onboarding@resend.dev>
# Dirección pública de la app: se usa para el enlace de gestión de la reserva.
APP_URL=
