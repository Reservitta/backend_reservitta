PORT=3000

# Cuenta Gmail con Verificacion en 2 pasos activada
GMAIL_USER=tu_correo_reservitta@gmail.com

# Contrasena de aplicacion de 16 caracteres generada en Google Account -> Seguridad
GMAIL_APP_PASSWORD=xxxx_xxxx_xxxx_xxxx

# Nombre visible del remitente
EMAIL_FROM_NAME=Reservitta

# Origenes permitidos para CORS (separados por coma)
ALLOWED_ORIGINS=https://reservitta-dev.web.app,https://reservitta-dev.firebaseapp.com

# Verificacion de token de Firebase Auth (true recomendado en produccion)
REQUIRE_FIREBASE_AUTH=true
FIREBASE_PROJECT_ID=reservitta-dev

